<!-- Road-user types for the Gurgaon simulation (step 2, approved 27 Oct 2026).

Every road user of a type shares these base properties; only its desired speed varies (speedFactor, a
multiple of the road's limit, drawn once per road user). Desired speeds average about 70% of the limit
(28 Oct): at the full limit, simulated speeds ran about 30% above the measured ones. Sizes are typical Indian vehicles. Acceleration,
braking and reaction times are standard values for mixed Indian traffic, to be tuned until the simulated
speeds match the measured ones (morning / night 85th percentile from our tracks: car 36 / 41 km/h,
two-wheeler 42 / 44, auto 34, bus 37, truck 42 / 22, cycle 26).

Units: metres, m/s, m/s^2, seconds.
- maxSpeed: top speed. speedFactor: desired speed as a multiple of the road limit (mean, spread, min, max).
- accel / decel / emergencyDecel: acceleration, normal braking, hardest braking.
- tau: reaction time (the Krauss model keeps a gap it can stop in after this delay).
- sigma: driver imperfection, how much a driver drifts off the ideal speed (0 is a perfect driver).
- minGap: gap kept to the vehicle ahead when standing. minGapLat: side gap kept while moving.
- latAlignment: where in the lane it rides when free. Two-wheelers and autos still filter past slower
  vehicles within a lane (lcSublane) but drift back to the centre: riding off-centre through junctions made
  them overlap other vehicles there, since SUMO's junction rules assume centred vehicles (28 Oct).
  The network is left-hand, so "right" is the kerb side
  (checked 28 Oct: a cycle with "right" rides 1.3 m left of the kerb lane's centre). lcSublane: eagerness to move sideways within and
  between lanes to get ahead (filtering). maxSpeedLat: fastest sideways speed.
The sublane model needs lateral-resolution set in the run config (gurgaon.sumocfg). -->
<additional>
    <vType id="car" vClass="passenger" length="4.3" width="1.8" minGap="1.5" minGapLat="0.5"
           maxSpeed="19.44" speedFactor="normc(0.7,0.1,0.5,1.0)"
           accel="2.5" decel="4.5" emergencyDecel="8" tau="1.0" sigma="0.5"
           latAlignment="center" lcSublane="1" maxSpeedLat="1.0" color="0.85,0.85,0.85"/>

    <vType id="two_wheeler" vClass="motorcycle" length="1.9" width="0.7" minGap="0.5" minGapLat="0.3"
           maxSpeed="19.44" speedFactor="normc(0.75,0.12,0.5,1.05)"
           accel="3.5" decel="5" emergencyDecel="8" tau="0.6" sigma="0.5"
           latAlignment="center" lcSublane="3" lcPushy="0.5" maxSpeedLat="1.5" color="1,0.75,0"/>

    <vType id="auto" vClass="passenger" length="2.7" width="1.4" minGap="0.8" minGapLat="0.4"
           maxSpeed="13.89" speedFactor="normc(0.7,0.1,0.5,1.0)"
           accel="1.6" decel="4" emergencyDecel="7" tau="0.8" sigma="0.5"
           latAlignment="center" lcSublane="2" maxSpeedLat="1.0" color="0.2,0.75,0.3"/>

    <vType id="bus" vClass="bus" length="11" width="2.5" minGap="2.5" minGapLat="0.8"
           maxSpeed="15.28" speedFactor="normc(0.7,0.08,0.55,0.9)"
           accel="1.2" decel="3.5" emergencyDecel="6" tau="1.2" sigma="0.5"
           latAlignment="center" lcSublane="0.5" maxSpeedLat="0.6" color="0.2,0.45,0.95"/>

    <vType id="truck" vClass="truck" length="7.5" width="2.4" minGap="2.5" minGapLat="0.8"
           maxSpeed="13.89" speedFactor="normc(0.7,0.08,0.55,0.9)"
           accel="1.0" decel="3.5" emergencyDecel="6" tau="1.3" sigma="0.5"
           latAlignment="center" lcSublane="0.5" maxSpeedLat="0.6" color="0.55,0.35,0.2"/>

    <vType id="cycle" vClass="bicycle" length="1.7" width="0.6" minGap="0.5" minGapLat="0.3"
           maxSpeed="5.56" speedFactor="normc(1,0.1,0.7,1.2)"
           accel="1.0" decel="3" emergencyDecel="5" tau="1.0" sigma="0.5"
           latAlignment="right" lcSublane="0.5" maxSpeedLat="0.5" color="0.7,0.3,0.8"/>

    <vType id="pedestrian" vClass="pedestrian" length="0.5" width="0.5" minGap="0.25"
           desiredMaxSpeed="1.3" speedFactor="normc(1,0.15,0.7,1.4)" color="1,0.3,0.3"/>
</additional>
